# nginx:alpine fills in ${API_URL} from the environment at container start
# (only variables that are actually set are replaced, so $host etc. stay as nginx variables).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # API and live updates go to Spring Boot, on the same origin as the app (so cookies and CSRF just work).
    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Server-Sent Events: don't buffer, keep the connection open.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Hashed build files can be cached for a long time.
    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Everything else is the Angular app (client-side routes like /sign-in).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
